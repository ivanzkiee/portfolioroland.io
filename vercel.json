{
  "version": 2,
  "buildCommand": "python manage.py migrate --noinput && python manage.py collectstatic --noinput --clear",
  "functions": {
    "api/index.py": {
      "excludeFiles": [
        "staticfiles/**"
      ]
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
