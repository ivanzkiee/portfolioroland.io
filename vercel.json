{
  "version": 2,
  "buildCommand": "python manage.py migrate --noinput",
  "functions": {
    "api/index.py": {
      "excludeFiles": "static/portfolio/images/video/**"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
