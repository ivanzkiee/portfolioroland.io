{
  "version": 2,
  "buildCommand": "python manage.py migrate --noinput",
  "functions": {
    "api/index.py": {
      "excludeFiles": [
        "static/**",
        "staticfiles/**",
        "staticfiles_collected/**"
      ]
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
